# ── Secretos (imprescindibles) ────────────────────────────────
# La misma clave se usa para Decisions y para Chat Completions.
OPENAI_API_KEY=

# ── Compose / Traefik ─────────────────────────────────────────
# Puerto publicado solo en 127.0.0.1 (debug). En el VPS usa uno libre (p. ej. 8091).
# APP_PORT=8080
# Dominio y router de Traefik (en local, localhost y sin Traefik).
# ROUTER=photo-clean
# DOMAIN=photo-clean.nestorpons.com

# ── Archivo de configuración ──────────────────────────────────
# Rutas de API, límites y valores por defecto viven en config/config.yaml.
# CONFIG_FILE=config/config.yaml

# ── Overrides opcionales sobre config/config.yaml ─────────────
# APP_ADDR=:8080
# APP_ENV=development
# CLASSIFIER_PROVIDER=decisions
# CLASSIFIER_THRESHOLD=0.5
# CLASSIFY_CONCURRENCY=4
# CLASSIFY_TIMEOUT=60s
# CLASSIFIER_MIN_RECALL=0.95
# DECISIONS_BASE_URL=https://api.openai.com/v1
# DECISIONS_ENDPOINT=/decisions
# DECISIONS_MODEL=gpt-6-luna
# DECISIONS_MAX_IMAGE_SIDE=1536
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ENDPOINT=/chat/completions
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_DETAIL=auto
# WEB_MAX_UPLOAD_BYTES=314572800
# WEB_MAX_JOBS=2
# WEB_JOB_TTL=1h
# ZIP_MAX_TOTAL_BYTES=1073741824
